# Server-side YouTube Data API v3 key.
# The public channel identity is already configured in app/site-data.ts.
YOUTUBE_API_KEY=

# Set to true only for the public production-domain deployment.
SITE_IS_PRODUCTION=false

# Search crawlers are allowed at launch. Model-training crawlers stay blocked
# unless this is explicitly set to true.
ALLOW_AI_TRAINING=false

# Optional privacy-conscious analytics and search-engine verification.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
